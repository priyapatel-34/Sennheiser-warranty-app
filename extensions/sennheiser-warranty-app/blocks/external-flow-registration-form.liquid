{% if customer or request.design_mode %}

  <div id="tws-warranty" class="register-warranty-form-section">
  
    <!-- HEADER -->
    <section class="mp-header">
      <div class="mp-user-info"> 
      <div class="avatar-wrap">
        <div class="mp-avatar">
        
          {% if customer.first_name != blank %}
            {{ customer.first_name | slice: 0, 1 }}
          {% else %}
            U
          {% endif %}
        </div>
  </div>
  <div class="mp-user-text">
    <h1>
      {{ block.settings.greeting_text }}
  
      {% if customer.first_name != blank %}
        {{ customer.first_name }}
      {% else %}
        Customer
      {% endif %}
    </h1>
  
    <p>{{ customer.email }}</p>
    <a href="{{ routes.account_logout_url }}" class="mp-logout">
      <em class="logout-icon">
      <img
    src="{{ 'logout-icon.svg' | asset_url }}"
    alt="Logout Icon"
  />
      </em>
      <span>Logout</span>
  </a>
  </div>
  
      <div class="mp-header-desc">
        <p>
          Welcome to your account. Check your order history,
          register your products, and manage your personal data – all in one place!
        </p>
      </div>
    </section>
  
  {% render 'ew-offer-transition' %}

  <div class="tws-bg ew-registration-form-panel">
  <div class="tws-wrap">
  
  <div id="successMessage" class="tws-success-message">
        <img 
          src="{{ 'active-icon.svg' | asset_url }}" 
          alt="Success Icon" 
          class="success-icon"
        >
    <span>Thank you. Product Registered Successfully!</span>
  </div>
  
  <div class="title-wrapper">
    <h2 class="tws-title">Register Your Product Warranty</h2>
  </div>
  
  <form class="custom-register-warranty-form" id="twsForm" novalidate>
  
  <div class="form-inner-wrap">
  
            <!-- CUSTOMER INFO -->
  <input type="hidden" id="customerId" value="{{ customer.id }}">
  <input type="hidden" id="info-icon" value="{{ 'info-icon.svg' | asset_url }}">
  <input type="hidden" id="my_products_link" value="{{ block.settings.my_products_link }}">
  <input type="hidden" id="storefrontLocale" value="{{ request.locale.iso_code }}">
  
  <div class="form-control form-input">
  <label>Name</label>
              <input
                id="customerName"
                value="{{ customer.first_name }} {{ customer.last_name }}">
  </div>
  
  <div class="form-control form-input">
  <label>Email</label>
  <input id="customerEmail" readonly value="{{ customer.email }}">
  </div>
  
            <!-- EXTERNAL PURCHASE -->
  <div id="externalStep" class="panel-inner">
  
              <div id="externalProducts" data-info-icon="{{ 'info-icon.svg' | asset_url }}"></div>
  
  <button type="button" class="add" id="addProduct">
  + Add Another Product
  </button>
  
  <div class="field-error" id="externalProductsError"></div>
  
  </div>
  
            <!-- CONSENTS -->
  <div class="panel-inner">
  
  <div class="consent-wrapper">
  <label class="consent-label">
  <input type="checkbox" id="consentCheckbox1">
  
  <span class="consent-text">
  Your product warranty information will be processed in compliance with our
  <a href="{{ block.settings.privacy_notice_link }}" target="_blank">
  Privacy Notice
  </a>.
  </span>
  
  </label>
  <div class="field-error" id="consentPrivacyError"></div>
  </div>
  
  <div class="consent-wrapper">
  <label class="consent-label">
  
  <input type="checkbox" id="consentCheckbox2">
  
  <span class="consent-text">
                        Please retain your proof of purchase. A valid proof of purchase is required to make a warranty claim. Full warranty terms are available here: 
                        <a href="{{ block.settings.warranty_terms_link }}" target="_blank" rel="noopener">
  Warranty Conditions
  </a>.
  </span>
  
  </label>
  <div class="field-error" id="consentConfirmError"></div>
  </div>
  
  </div>
  
  <div class="btn-wrap">
  <button type="submit" class="btn submit-btn">Submit</button>
  </div>
  
  </div>
  
  </form>
  
  </div>
  </div>
  
  </div>
  
  <!-- TEMPLATE FOR PRODUCT BLOCK -->
  
  <template id="external-product-template">
  
  <div class="product-block">
  
  <div class="external-products-wrapper form-inner-wrap">
  
  <div class="form-control form-input">
  <label class="wg-translatable">Product Name / Model</label>
  <input data-autocomplete>
  <div class="field-error"></div>
  </div>
  
  <div class="form-control form-input">
  <label class="wg-translatable">Purchased Date</label>
  <input type="date" class="purchase-date">
  <div class="field-error"></div>
  </div>
  
  <div class="form-control form-input">
  
  <div class="label-with-icon-wrap">
  <label class="wg-translatable">Retailer</label>
  
  <div class="custom-toolip-wrap">
  <span class="info-icon">
  <img src="{{ 'info-icon.svg' | asset_url }}">
  </span>
  
  <div class="tooltip">
  <span class="wg-translatable">
  Please select an authorized retailer.
  </span>
  </div>
  
  </div>
  </div>
  
  <input data-retailer-autocomplete autocomplete="off" placeholder="Select Retailer">
  <div class="field-error"></div>
  
  </div>
  
  <div class="form-control form-input">
  
  <div class="label-with-icon-wrap">
  <label class="wg-translatable">Serial Number</label>
  
  <div class="custom-toolip-wrap">
  <span class="info-icon">
  <img src="{{ 'info-icon.svg' | asset_url }}">
  </span>
  
  <div class="tooltip">
  {% if block.settings.serial_number_help_url != blank %}
    <a
      href="{{ block.settings.serial_number_help_url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="wg-translatable"
    >
      The serial number can be found on the product packaging.
    </a>
  {% else %}
    <span class="wg-translatable">
      The serial number can be found on the product packaging.
    </span>
  {% endif %}
  </div>
  
  </div>
  </div>
  
  <input data-serial>
  <div class="field-error"></div>
  
  </div>
  
  <button type="button" class="remove wg-translatable">
  − Remove Product
  </button>
  
  </div>
  
  </div>
  
  </template>
  
  <!-- Hidden block for Weglot scanning -->
  
  <div style="display:none">
  
  <span class="wg-translatable">Product Name / Model</span>
  <span class="wg-translatable">Purchased Date</span>
  <span class="wg-translatable">Retailer</span>
  <span class="wg-translatable">Serial Number</span>
  <span class="wg-translatable">Remove Product</span>
  
  </div>
  
  {% else %}
  <script>location.href='/account/login'</script>
  {% endif %}
  
  {{ 'external-purchase-form.css' | asset_url | stylesheet_tag }}
  {{ 'warranty-toast.css' | asset_url | stylesheet_tag }}
  {{ 'extended-warranty-offer.css' | asset_url | stylesheet_tag }}
  {{ 'warranty-toast.js' | asset_url | script_tag }}
  {{ 'warranty-flow-state.js' | asset_url | script_tag }}
  {{ 'extended-warranty-offer.js' | asset_url | script_tag }}
  {{ 'external-purchase-form.js' | asset_url | script_tag }}
  
  {% schema %}
  {
    "name": "External Register Form",
    "target": "section",
    "settings": [
      {
        "type": "text",
        "id": "greeting_text",
        "label": "Greeting text",
        "default": "Hi"
      },
      {
        "type": "url",
        "id": "privacy_notice_link",
        "label": "Privacy Notice Link"
      },
      {
        "type": "url",
        "id": "warranty_terms_link",
        "label": "Warranty Terms Link",
        "info": "Link to full warranty terms and conditions"
      },
      {
        "type": "url",
        "id": "my_products_link",
        "label": "My Products page Link",
        "info": "My products page link"
      },
      {
        "type": "url",
        "id": "serial_number_help_url",
        "label": "Serial Number Help URL",
        "info": "URL explaining where customers can find the serial number"
      }
    ]
  }
  {% endschema %}