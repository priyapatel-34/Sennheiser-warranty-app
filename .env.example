# ---------------------------------------------------------------------------
# Sennheiser Warranty App — environment template
# Copy this file to `.env` and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Shopify app credentials ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_orders,write_orders
# Public app URL (used for OAuth host + webhook callbacks), e.g. https://your-app.example.com
HOST=
SHOPIFY_APP_URL=

# --- Server ports ---
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=8080
# Optional fallback if BACKEND_PORT is not set
PORT=3000

# --- MySQL database ---
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306
# Connection string used by the Shopify MySQL session storage
MYSQL_DATABASE_URL=mysql://user:password@host:3306/database

# --- Email (SendGrid) ---
# EMAIL_MODE: auto | production | test | log
EMAIL_MODE=auto
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
DEFAULT_FROM_EMAIL=

# --- Extended warranty eligibility reminder job ---
# Set to "false" to disable the scheduled reminder emails
EW_REMINDER_EMAILS_ENABLED=true
# Interval between reminder job runs, in milliseconds (default 6h)
EW_REMINDER_JOB_INTERVAL_MS=21600000
